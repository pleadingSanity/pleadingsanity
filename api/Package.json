{
  "name": "pleading-sanity",
  "version": "2.0.0-FINAL",
  "private": true,
  "description": "Pleading Sanity — Rise From Madness. Cosmic hub for healing, survivor stories, community, and the movement. Evolution Not Erasure.",
  "author": "Shane Cooper",
  "license": "MIT",
  "homepage": "https://pleadingsanity.co.uk",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleadingSanity/pleading-sanity.git"
  },
  "scripts": {
    "dev": "next dev",
    "dev:netlify": "netlify dev",
    "build": "next build",
    "postbuild": "npm run sitemap",
    "start": "next start -p 3000",
    "export": "next export",
    "lint": "next lint",
    "format": "prettier --write .",
    "analyze": "cross-env ANALYZE=true next build",
    "sitemap": "next-sitemap"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "framer-motion": "^11.18.0",
    "mailchimp-marketing": "^4.1.0",
    "next": "15.1.0",
    "next-seo": "^6.6.0",
    "next-sitemap": "^4.2.3",
    "pako": "^2.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.4.0",
    "react-player": "^2.16.0",
    "sharp": "^0.33.5",
    "swr": "^2.3.0",
    "zustand": "^5.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.9.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "netlify-cli": "^17.37.0",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.17 <21",
    "npm": ">=10"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "mental-health",
    "survivor",
    "healing",
    "movement",
    "community",
    "sanity-hub",
    "pleading-sanity",
    "rise-from-madness",
    "evolution-not-erasure"
