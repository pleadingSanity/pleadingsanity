# Pleading Sanity - Cosmic Network Environment Variables
# Copy this file to .env.local and fill in your actual API keys

# =============================================
# ARRON AI CORE - OpenAI Integration
# =============================================
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# =============================================
# YOUTUBE DATA API - Video Feed
# =============================================
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=UC0iP4yT2PpQqhFQ0oEc7ZVw

# =============================================
# SHOPIFY INTEGRATION - Merch Store
# =============================================
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_secret_here
SHOPIFY_STORE_DOMAIN=dqfzb1-ki.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_token_here

# =============================================
# PAYHIP INTEGRATION - Alternative Store
# =============================================
PAYHIP_API_KEY=your_payhip_api_key_here

# =============================================
# ARRON API - FileFixer Integration
# =============================================
ARRON_API_KEY=PLEADINGSANITY_API_KEY_1234
ARRON_API_UPDATE=https://filefixerapi.com/api/v1/filefixer/update-website
ARRON_API_DEPLOY=https://filefixerapi.com/api/v1/filefixer/deploy-website
ARRON_API_STATUS=https://filefixerapi.com/api/v1/filefixer/get-website-status

# =============================================
# SITE CONFIGURATION
# =============================================
NEXT_PUBLIC_SITE_URL=https://pleadingsanity.co.uk
NODE_ENV=production

# =============================================
# MAILCHIMP (Newsletter)
# =============================================
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_AUDIENCE_ID=your_audience_id_here

# =============================================
# ANALYTICS (Optional)
# =============================================
GOOGLE_ANALYTICS_ID=your_ga_id_here
