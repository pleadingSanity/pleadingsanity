# ========================================
# 🌐 CORE SITE
# ========================================
NODE_ENV=production
PORT=3000
SITE_URL=https://pleadingsanity.co.uk
SITE_NAME="Pleading Sanity"
SITE_DESCRIPTION="Rise From Madness — Cosmic healing, survivor community, streetwear, frequencies & AI companion"
ALLOWED_ORIGINS=https://pleadingsanity.co.uk https://pleadingsanity.uk https://*.netlify.app https://*.vercel.app

# ========================================
# 📺 YOUTUBE API
# ========================================
# Get key → https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Resolved 2026-10-31 from https://www.youtube.com/@shanecooper1872
# (canonical https://www.youtube.com/channel/UC3q3UpppLMXrq45czZT4_HQ).
# The previous channel id returned 404.
YOUTUBE_CHANNEL_ID=UC3q3UpppLMXrq45czZT4_HQ
# Playlist RSS returned 404 on 2026-10-31. Left here so existing page
# references stay visible; do not treat it as a live Shane Cooper list.
YOUTUBE_PLAYLIST_ID=PL7C1VriGLDPrAq1Im9t7WQxZcuXlA77DA

# ========================================
# 🧠 ARRON TEXT CHAT (ai-chain.ts / arron.mts)
# Completely separate from Creations image generation.
# Netlify AI Gateway injects OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY
# + matching BASE_URL unless you set your own. Set your own for full control.
# ========================================
# Get key → https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model override (soul file is overridden by this)
OPENAI_MODEL=
# Get key → https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Alternative name also accepted
Anthropic_Key_Arron=
CLAUDE_MODEL=
ANTHROPIC_MODEL=
# Get key → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
# Get key → https://console.x.ai/
GROK_API_KEY=
xAI_KEY=
XAI_API_KEY=
GROK_MODEL=
# Optional OpenRouter for free spares (only if PS_SPARES_PRIVACY_APPROVED=true)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# Optional
PS_SPARES_PRIVACY_APPROVED=
PS_PAID_SPARES_APPROVED=
PS_IN_PROFIT=

ARRON_API_ENDPOINT=https://filefixerapi.com/api/v1/filefixer
ARRON_API_KEY=
ARRON_AI_MODEL=gpt-4
ARRON_AI_TEMPERATURE=0.7

# Owner emails (comma-separated). Required for Creator Mode / owner actions.
NETLIFY_OWNER_EMAILS=

# ========================================
# 🎨 CREATIONS IMAGE GENERATION (netlify/functions/creations.mts)
# Dedicated path — does NOT use the Arron text chat keys above.
# ========================================
# Preferred: your own Gemini image key (or leave blank to use Netlify AI Gateway inject)
CREATIONS_IMAGE_API_KEY=
CREATIONS_IMAGE_BASE_URL=
# Model — default gemini-2.5-flash-image (valid on Netlify AI Gateway)
# Alternatives: gemini-3.1-flash-lite-image , gemini-2.5-flash-image-preview
CREATIONS_IMAGE_MODEL=
# Gateway injects (always present on Netlify Functions if AI Gateway is enabled)
# NETLIFY_AI_GATEWAY_KEY=
# NETLIFY_AI_GATEWAY_BASE_URL=

