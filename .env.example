# Pleading Sanity Environment Variables Example
# Copy this file to .env and fill in your actual values

# NEVER commit .env files with real values to git!

# ================================
# CORE APPLICATION SETTINGS
# ================================
NODE_ENV=development
PORT=3000
SITE_URL=https://pleadingsanity.co.uk
SITE_NAME="Pleading Sanity"
SITE_DESCRIPTION="Rise From Madness - A cosmic hub for healing, resilience, and community"

# ================================
# YOUTUBE API CONFIGURATION
# ================================
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=UC0iP4yT2PpQqhFQ0oEc7ZVw
YOUTUBE_PLAYLIST_ID=PL7C1VriGLDPrAq1Im9t7WQxZcuXlA77DA

# ================================
# OPENAI / CHATGPT CONFIGURATION
# ================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
NEXT_PUBLIC_OPENAI_API_KEY=your_public_openai_key_here

# ================================
# EMAIL & NEWSLETTER
# ================================
# Mailchimp configuration
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_AUDIENCE_ID=your_mailchimp_audience_id_here
MAILCHIMP_URL=https://your_mailchimp_signup_url_here

# Alternative email service (if not using Mailchimp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Contact form email
CONTACT_EMAIL=pleadingsanity1@gmail.com

# ================================
# E-COMMERCE / SHOP INTEGRATION
# ================================
# Shopify configuration
SHOPIFY_STORE_URL=https://dqfzb1-ki.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here

# PayHip configuration
PAYHIP_STORE_ID=Pleadingsanity
PAYHIP_API_KEY=your_payhip_api_key_here

# TikTok Shop
TIKTOK_SHOP_URL=https://vt.tiktok.com/ZNd4wRFfn/?page=TikTokShop

# ================================
# SOCIAL MEDIA INTEGRATION
# ================================
INSTAGRAM_USERNAME=mentally.inshane
TIKTOK_USERNAME=mentally.inshane
TWITTER_USERNAME=pleadingsanity
YOUTUBE_USERNAME=pleadingsanity

# Social media API keys (if needed for feeds)
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here
TIKTOK_ACCESS_TOKEN=your_tiktok_token_here

# ================================
# ANALYTICS & TRACKING
# ================================
# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID_HERE

# Other analytics
HOTJAR_ID=your_hotjar_id_here
MIXPANEL_TOKEN=your_mixpanel_token_here

# ================================
# PWA & PUSH NOTIFICATIONS
# ================================
# Firebase for push notifications
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=pleading-sanity
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here

# Web Push VAPID keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=pleadingsanity1@gmail.com

# ================================
# DATABASE (if needed)
# ================================
# MongoDB
MONGODB_URI=mongodb://localhost:27017/pleadingsanity
MONGODB_DB=pleadingsanity

# PostgreSQL (alternative)
DATABASE_URL=postgresql://username:password@localhost:5432/pleadingsanity

# ================================
# HOSTING & DEPLOYMENT
# ================================
# Netlify
NETLIFY_SITE_ID=your_netlify_site_id_here
NETLIFY_ACCESS_TOKEN=your_netlify_token_here

# Vercel
VERCEL_TOKEN=your_vercel_token_here

# GitHub (for actions/deployment)
GITHUB_TOKEN=your_github_token_here

# ================================
# SECURITY & AUTHENTICATION
# ================================
# JWT secret for user authentication (if implemented)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Session secret
SESSION_SECRET=your_session_secret_here_min_32_chars

# API rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ================================
# EXTERNAL APIS
# ================================
# ZenQuotes API (for daily inspiration)
ZENQUOTES_API_KEY=your_zenquotes_key_here

# Unsplash (for cosmic imagery)
UNSPLASH_ACCESS_KEY=your_unsplash_key_here

# Weather API (if used for cosmic vibes)
WEATHER_API_KEY=your_weather_api_key_here

# ================================
# DEVELOPMENT TOOLS
# ================================
# Sentry for error tracking
SENTRY_DSN=your_sentry_dsn_here

# LogRocket for user session replay
LOGROCKET_APP_ID=your_logrocket_id_here

# ================================
# CONTENT MANAGEMENT
# ================================
# Contentful (if using headless CMS)
CONTENTFUL_SPACE_ID=your_contentful_space_id_here
CONTENTFUL_ACCESS_TOKEN=your_contentful_token_here

# Sanity.io (alternative CMS)
SANITY_PROJECT_ID=your_sanity_project_id_here
SANITY_DATASET=production

# ================================
# AUDIO HEALING FREQUENCIES
# ================================
# API for generating healing frequencies (if using external service)
HEALING_FREQUENCY_API_KEY=your_frequency_api_key_here

# ================================
# ARRON AI CONFIGURATION
# ================================
# Custom AI endpoint configuration
ARRON_API_ENDPOINT=https://filefixerapi.com/api/v1/filefixer
ARRON_API_KEY=PLEADINGSANITY_API_KEY_1234
ARRON_AI_MODEL=gpt-4
ARRON_AI_TEMPERATURE=0.7

# ================================
# BACKUP & STORAGE
# ================================
# AWS S3 for file storage
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_BUCKET_NAME=pleading-sanity-assets
AWS_REGION=us-east-1

# Cloudinary for image optimization
CLOUDINARY_CLOUD_NAME=your_cloudinary_name_here
CLOUDINARY_API_KEY=your_cloudinary_key_here
CLOUDINARY_API_SECRET=your_cloudinary_secret_here
