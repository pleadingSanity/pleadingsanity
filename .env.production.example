# Pleading Sanity Production Environment Variables
# Copy this to .env.production and fill in your production values
# IMPORTANT: Never commit .env.production to git!

# ================================
# PRODUCTION DEPLOYMENT SETTINGS
# ================================
NODE_ENV=production
SITE_URL=https://pleadingsanity.co.uk
PORT=3000

# ================================
# AI AUTHENTICATION - REQUIRED FOR FULL FUNCTIONALITY
# ================================
# OpenAI API Key for ChatGPT/Arron AI
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-production-openai-key-here
NEXT_PUBLIC_OPENAI_API_KEY=sk-your-public-openai-key-here

# Arron AI Custom API (FileFixer API)
ARRON_API_KEY=your-production-arron-api-key-here
ARRON_API_ENDPOINT=https://filefixerapi.com/api/v1/filefixer
ARRON_AI_MODEL=gpt-4
ARRON_AI_TEMPERATURE=0.7

# ================================
# YOUTUBE API - REQUIRED FOR VIDEO FEED
# ================================
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_CHANNEL_ID=UC0iP4yT2PpQqhFQ0oEc7ZVw
YOUTUBE_PLAYLIST_ID=PL7C1VriGLDPrAq1Im9t7WQxZcuXlA77DA

# ================================
# ANALYTICS & MONITORING
# ================================
NEXT_PUBLIC_GA_ID=G-your-analytics-id-here
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID_HERE

# ================================
# EMAIL & NEWSLETTER
# ================================
MAILCHIMP_API_KEY=your-production-mailchimp-key-here
MAILCHIMP_AUDIENCE_ID=your-audience-id-here
MAILCHIMP_URL=https://your-mailchimp-signup-url-here
CONTACT_EMAIL=pleadingsanity1@gmail.com

# ================================
# E-COMMERCE INTEGRATION
# ================================
SHOPIFY_STORE_URL=https://dqfzb1-ki.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-production-shopify-token-here
PAYHIP_STORE_ID=Pleadingsanity
PAYHIP_API_KEY=your-production-payhip-key-here
TIKTOK_SHOP_URL=https://vt.tiktok.com/ZNd4wRFfn/?page=TikTokShop

# ================================
# SECURITY & AUTHENTICATION
# ================================
JWT_SECRET=your-super-secure-production-jwt-secret-min-32-chars
SESSION_SECRET=your-super-secure-session-secret-min-32-chars
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ================================
# HOSTING & DEPLOYMENT
# ================================
NETLIFY_SITE_ID=your-netlify-site-id-here
NETLIFY_ACCESS_TOKEN=your-netlify-token-here
VERCEL_TOKEN=your-vercel-token-here
GITHUB_TOKEN=your-github-token-here

# ================================
# FHIR HEALTHCARE INTEGRATION (Optional)
# ================================
FHIR_CLIENT_ID=your-fhir-client-id-here
FHIR_CLIENT_SECRET=your-fhir-client-secret-here

# ================================
# DATABASE (If using)
# ================================
DATABASE_URL=your-production-database-url-here
MONGODB_URI=your-production-mongodb-uri-here

# ================================
# ERROR TRACKING & MONITORING
# ================================
SENTRY_DSN=your-production-sentry-dsn-here
LOGROCKET_APP_ID=your-logrocket-id-here

# ================================
# CLOUD STORAGE (If using)
# ================================
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_BUCKET_NAME=pleading-sanity-assets
AWS_REGION=us-east-1

CLOUDINARY_CLOUD_NAME=your-cloudinary-name-here
CLOUDINARY_API_KEY=your-cloudinary-key-here
CLOUDINARY_API_SECRET=your-cloudinary-secret-here
