{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pleading-sanity.vercel.app" }],
      "destination": "https://pleadingsanity.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.pleadingsanity.uk" }],
      "destination": "https://pleadingsanity.co.uk/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "www.pleadingsanity.uk" }],
      "destination": "https://pleadingsanity.co.uk/:path+",
      "permanent": true
    }
  ]
}
