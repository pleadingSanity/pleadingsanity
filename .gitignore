# ==============================================================
# 🌌 PLEADING SANITY — GITIGNORE
# Keep secrets, builds & private data OFFLINE
# Evolution, Not Erasure • Secure by design
# ==============================================================

# ========================================
# 🔑 SECURITY — NEVER COMMIT
# ========================================
.env
.env.*
!.env.example
config/keys.js
config/production.json
*.pem
*.key
*.crt
ssl/

# ========================================
# 📦 DEPENDENCIES
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================================
# 🏗️ BUILD OUTPUT
# ========================================
build/
dist/
.next/
out/
.cache/
.parcel-cache/
.netlify/
.vercel/

# ========================================
# 📝 LOGS & RUNTIME
# ========================================
*.log
logs/
pids/
*.pid
*.pid.lock

# ========================================
# 💾 DATABASE & LOCAL DATA
# ========================================
*.db
*.sqlite
*.sqlite3
journal-backups/
user-data/
chat-logs/
uploads/temp/

# ========================================
# 🧪 TESTS & COVERAGE
# ========================================
coverage/
.nyc_output/
test-results/

# ========================================
# 💻 IDE & EDITOR
# ========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db

# ========================================
# 📄 TEMP & DRAFTS
# ========================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
dev-notes.md
TODO.md
NOTES.md
content/drafts/
content/private/

# ========================================
# 🔒 LOCAL CONFIG — OVERRIDES
# ========================================
local.json
config.local.js
*.local.js

# ========================================
# 📦 LOCK FILES — KEEP ONE, COMMENT THE OTHER
# ========================================
# We use npm — keep package-lock.json, ignore yarn.lock
yarn.lock

# ========================================
# ✅ END — Protected & Ready
# ========================================
