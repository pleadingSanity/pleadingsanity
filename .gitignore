# ==============================================================
# 🌌 PLEADING SANITY — GITIGNORE v2.1-FINAL
# Keep secrets, builds & private data OFFLINE
# Evolution, Not Erasure • Secure by Design
# ==============================================================

# ========================================
# 🔑 SECURITY — NEVER COMMIT
# ========================================
.env
.env.*
!.env.example
!.env.production.example
config/
*.pem
*.key
*.crt
*.p12
*.pfx
ssl/
secrets/

# ========================================
# 📦 DEPENDENCIES
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# ========================================
# 🏗️ BUILD OUTPUT & PLATFORMS
# ========================================
build/
dist/
.next/
out/
.cache/
.parcel-cache/
.netlify/
.vercel/
.fasthost/

# ========================================
# 📝 LOGS & RUNTIME
# ========================================
*.log
logs/
pids/
*.pid
*.pid.lock

# ========================================
# 💾 DATABASE & SENSITIVE DATA
# ========================================
*.db
*.sqlite
*.sqlite3
journal-backups/
user-data/
chat-logs/
uploads/temp/
private/

# ========================================
# 🧪 TESTS & COVERAGE
# ========================================
coverage/
.nyc_output/
test-results/

# ========================================
# 💻 IDE, EDITOR & OS
# ========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db

# ========================================
# 📄 TEMP, DRAFTS & WORK IN PROGRESS
# ========================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
dev-notes.md
TODO.md
NOTES.md
content/drafts/

# ========================================
# 🔒 LOCAL OVERRIDES
# ========================================
local.json
config.local.js
*.local.js

# ========================================
# 📦 LOCK FILES — KEEP npm ONLY
# ========================================
package-lock.json
# yarn.lock          ← npm only
# pnpm-lock.yaml     ← npm only

# ========================================
# ✅ END — SECURED • CLEAN • READY
# ========================================
