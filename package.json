{
  "name": "pleading-sanity",
  "version": "2.0.0",
  "private": true,
  "description": "Pleading Sanity – Rise From Madness. Cosmic hub for healing, survivor stories, frequencies, community, and the movement.",
  "homepage": "https://pleadingsanity.co.uk",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleadingSanity/pleadingsanity.git"
  },
  "author": {
    "name": "Shane Cooper",
    "email": "pleadingsanity1@gmail.com",
    "url": "https://pleadingsanity.co.uk"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:netlify": "netlify dev",
    "dev:static": "python -m http.server 3000",
    "build": "next build && npm run optimize",
    "build:static": "npm run optimize && npm run minify",
    "postbuild": "npm run sitemap && npm run sw:update",
    "start": "next start -p 3000",
    "start:static": "python -m http.server 3000",
    "export": "next export",
    "preview": "npm run build && npm run start",
    "setup:production": "./scripts/setup-production.sh",
    "check:deployment": "node check-deployment.js",
    "lint": "next lint && eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build",
    "sitemap": "next-sitemap",
    "sw:update": "node scripts/update-sw.js",
    "optimize": "npm run optimize:images && npm run optimize:css",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:css": "cleancss -o dist/styles.min.css styles.css animations.css accessibility.css nav-component.css",
    "minify": "node scripts/minify-html.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "npm run build && npm run deploy:netlify",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:vercel": "vercel --prod",
    "health-check": "node scripts/health-check.js",
    "backup": "node scripts/backup-data.js",
    "db:seed": "node scripts/seed-data.js",
    "security:audit": "npm audit && node scripts/security-scan.js"
  },
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "framer-motion": "^11.18.0",
    "next": "latest",
    "next-seo": "^6.6.0",
    "next-sitemap": "^4.2.3",
    "pako": "^2.1.0",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.4.0",
    "react-player": "^2.16.0",
    "sharp": "^0.33.5",
    "swr": "^2.3.3",
    "zustand": "^5.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.8.1",
    "cross-env": "^7.0.3",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "netlify-cli": "^17.38.0",
    "prettier": "latest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=20.18.0 <=24.x",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "mental-health",
    "movement",
    "survivor",
    "healing-frequencies",
    "sanity-hub",
    "pleading-sanity",
    "pwa",
    "healing",
    "cosmic",
    "streetwear",
    "community",
    "united-kingdom",
    "spiritual-awakening"
  ],
  "packageManager": "npm@10"
}
