{
  "name": "pleading-sanity",
  "version": "2.0.0",
  "private": true,
  "description": "Pleading Sanity – Rise From Madness. Cosmic hub for healing, videos, and the movement.",
  "homepage": "https://pleadingsanity.co.uk",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleadingSanity/pleadingsanity.git"
  },
  "author": {
    "name": "Shane Cooper",
    "email": "pleadingsanity1@gmail.com",
    "url": "https://pleadingsanity.co.uk"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:netlify": "netlify dev",
    "dev:static": "python -m http.server 3000",
    "build": "next build && npm run optimize",
    "build:static": "npm run optimize && npm run minify",
    "postbuild": "npm run sitemap && npm run sw:update",
    "start": "next start -p 3000",
    "start:static": "python -m http.server 3000",
    "export": "next export",
    "preview": "npm run build && npm run start",
    "lint": "next lint && eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build",
    "sitemap": "next-sitemap",
    "sw:update": "node scripts/update-sw.js",
    "optimize": "npm run optimize:images && npm run optimize:css",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:css": "cleancss -o dist/styles.min.css styles.css animations.css accessibility.css nav-component.css",
    "minify": "node scripts/minify-html.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "npm run build && npm run deploy:netlify",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:vercel": "vercel --prod",
    "health-check": "node scripts/health-check.js",
    "backup": "node scripts/backup-data.js",
    "db:seed": "node scripts/seed-data.js",
    "security:audit": "npm audit && node scripts/security-scan.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.0.0",
    "mailchimp-marketing": "^4.1.0",
    "next": "latest",
    "next-seo": "^6.5.0",
    "next-sitemap": "^4.2.3",
    "pako": "^2.1.0",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.0.1",
    "react-player": "^2.12.0",
    "sharp": "^0.33.3",
    "swr": "^2.2.5",
    "zustand": "^4.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.8.1",
    "cross-env": "^7.0.3",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.7",
    "netlify-cli": "^17.34.1",
    "prettier": "latest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.17.0 <21",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "mental-health",
    "movement",
    "videos",
    "sanity-hub",
    "pleading-sanity",
    "pwa",
    "healing",
    "cosmic",
    "streetwear",
    "community"
  ],
  "packageManager": "npm@10"
}
